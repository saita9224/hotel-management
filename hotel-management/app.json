{
  "expo": {
    "name": "BizzMan",
    "slug": "hotel-management",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Bizzman_logo.png",
    "scheme": "hotelmanagement",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/Bizzman_logo.png"
    },
    "android": {
      "package": "com.hoppers.businessmanagement",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/Bizzman_logo.png"
      },
      "icon": "./assets/images/Bizzman_logo.png",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Bizzman_full_logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "64bb6402-ccb1-4cf6-b1ff-834487a6b0c5"
      }
    },
    "owner": "n0607642018"
  }
}
